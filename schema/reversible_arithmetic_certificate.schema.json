{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reversible Arithmetic Resource Certificate",
  "type": "object",
  "required": [
    "certificate_version",
    "certificate_id",
    "circuit_hash",
    "gate_basis",
    "arithmetic_function",
    "arithmetic_parameters",
    "resource_counts",
    "io_spec",
    "test_generation",
    "correctness_transcript",
    "transcript_hash",
    "proof_artifact"
  ],
  "properties": {
    "certificate_version": {"type": "string"},
    "certificate_id": {"type": "string"},
    "circuit_hash": {"type": "string"},
    "public_circuit": {
      "type": "object",
      "properties": {
        "circuit_file": {"type": "string"},
        "circuit_hash": {"type": "string"},
        "circuit_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "gate_basis": {
      "type": "array",
      "items": {"type": "string"}
    },
    "arithmetic_function": {
      "type": "string",
      "enum": ["modular_inversion", "toy_cnot_copy", "toy_toffoli_and", "toy_swap", "toy_add_mod_2n"]
    },
    "arithmetic_parameters": {
      "type": "object",
      "required": ["modulus", "bit_length", "field"],
      "properties": {
        "modulus": {"type": "integer", "minimum": 2},
        "bit_length": {"type": "integer", "minimum": 1},
        "field": {"type": "string"}
      },
      "additionalProperties": true
    },
    "resource_counts": {
      "type": "object",
      "properties": {
        "logical_qubits": {"type": "integer", "minimum": 0},
        "ancilla_qubits": {"type": "integer", "minimum": 0},
        "toffoli_count": {"type": "integer", "minimum": 0},
        "cnot_count": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 0},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "io_spec": {
      "type": "object",
      "required": ["domain", "input_register", "output_register", "relation"],
      "properties": {
        "domain": {"type": "string"},
        "input_register": {"type": "string"},
        "output_register": {"type": "string"},
        "relation": {"type": "string"}
      },
      "additionalProperties": true
    },
    "test_generation": {
      "type": "object",
      "required": ["method", "label", "test_count", "exhaustive"],
      "properties": {
        "method": {"type": "string"},
        "label": {"type": "string"},
        "test_count": {"type": "integer", "minimum": 0},
        "exhaustive": {"type": "boolean"},
        "seed_circuit_hash": {"type": "string"}
      },
      "additionalProperties": true
    },
    "correctness_transcript": {
      "type": "object",
      "required": ["tests"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["passed"],
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"},
              "input_bits": {
                "type": "array",
                "items": {"type": "integer", "enum": [0, 1]}
              },
              "output_bits": {
                "type": "array",
                "items": {"type": "integer", "enum": [0, 1]}
              },
              "passed": {"type": "boolean"}
            },
            "anyOf": [
              {"required": ["x", "y", "passed"]},
              {"required": ["input_bits", "output_bits", "passed"]}
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "transcript_hash": {"type": "string"},
    "proof_artifact": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}